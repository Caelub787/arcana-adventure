{
  "include": [
    "client/src/**/*",
    "shared/**/*",
    "server/**/*",
    "packages/library-dialogs/src/**/*"
  ],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"],
      "@arcana/aa-sync-sdk": ["./packages/aa-sync-sdk/index.ts"],
      "@arcana/library-dialogs": ["./packages/library-dialogs/src/index.ts"],
      "@arcana/library-dialogs/theme.css": ["./packages/library-dialogs/src/theme.css"],
      "@cr/*": ["./client/src/canvasrealms/*"],
      "@workspace/api-zod": ["./client/src/canvasrealms/_pkg/api-zod/src/index.ts"],
      "@workspace/api-client-react": ["./client/src/canvasrealms/_pkg/api-client-react/src/index.ts"],
      "@workspace/db": ["./server/canvasrealms/db.ts"]
    }
  }
}
