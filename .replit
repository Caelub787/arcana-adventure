modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist/public"
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 33135
externalPort = 6800

[[ports]]
localPort = 33211
externalPort = 5173

[[ports]]
localPort = 33449
externalPort = 8081

[[ports]]
localPort = 34295
externalPort = 8000

[[ports]]
localPort = 34981
externalPort = 3003

[[ports]]
localPort = 35393
externalPort = 3001

[[ports]]
localPort = 36117
externalPort = 5000

[[ports]]
localPort = 37075
externalPort = 3002

[[ports]]
localPort = 39599
externalPort = 9000

[[ports]]
localPort = 42353
externalPort = 8080

[[ports]]
localPort = 43421
externalPort = 8008

[[ports]]
localPort = 45123
externalPort = 4200

[[ports]]
localPort = 46143
externalPort = 6000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
mockupState = "FULLSTACK"
integrations = ["resend:1.0.0"]
