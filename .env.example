# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
SESSION_SECRET=your-random-session-secret

# App Domain (used for CORS, OAuth redirects, session cookies)
APP_DOMAIN=https://arcanaadventure.com

# Optional: additional CORS origins (comma-separated)
# CORS_ORIGIN=https://admin.arcanaadventure.com,http://localhost:5000

# Google OAuth (per-user Google Docs import/export)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google Drive Image Library (GM asset browser)
# Option 1: Service account JSON key (preferred)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
# Option 2: OAuth access token (simpler but expires)
# GOOGLE_DRIVE_ACCESS_TOKEN=ya29.xxx

# Resend (password reset emails)
RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=Support@arcanaadventure.com

# Server
PORT=5000
NODE_ENV=production
