# Copy this file to .env and fill in real values for local development.
# On your host (Render, a VPS, etc.) set these as environment variables/secrets instead.

# --- Core ---
NODE_ENV=development
PORT=5000
# Public URL the app is served at (used for OAuth redirects, CORS, and social meta tags).
# Example: https://arcana-adventure.example.com
APP_URL=http://localhost:5000

# Postgres connection string (Neon or any Postgres works).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Secret used to sign session cookies — set this to a long random string.
SESSION_SECRET=

# --- Google Cloud Storage (file/image uploads) ---
# Full contents of a GCS service account key JSON file, or its base64 encoding.
GCS_SERVICE_ACCOUNT_KEY=
GCS_PROJECT_ID=
# /<bucket-name>/<path-prefix> style values pointing at buckets/paths you created.
PRIVATE_OBJECT_DIR=/your-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=Support@arcanaadventure.com

# --- Google integrations ---
# OAuth client used for (a) per-user "connect your Google account" note sync,
# and (b) the service-level Drive connection below. Create one OAuth client in
# Google Cloud Console with an authorized redirect URI of "$APP_URL/api/google/callback".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Refresh token for a Google account with access to the shared image library
# folder, obtained once via that account's OAuth consent screen. Powers the
# authenticated fallback in the GM image library browser.
GOOGLE_DRIVE_REFRESH_TOKEN=
# API key (no OAuth) used for read-only browsing of the public shared image library.
GOOGLE_API_KEY=
